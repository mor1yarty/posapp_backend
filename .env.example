# 環境変数設定例
# 本番環境では .env ファイルを作成し、適切な値を設定してください
# ⚠️ 本ファイルは設定例のため、実際の値は含まれていません

# Supabase REST API設定（HTTPSアクセス用）
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here

# PostgreSQL直接接続設定（SQLAlchemy用）
DB_HOST=db.your-project-id.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_NAME=postgres

# または、DATABASE_URLで一括設定も可能
# DATABASE_URL=postgresql://postgres:password@host:5432/database

# アプリケーション設定
ENVIRONMENT=development

# ===================================
# 本番環境での設定時の注意事項：
# ===================================
# 1. SUPABASE_URL: SupabaseプロジェクトのAPI URL
# 2. SUPABASE_KEY: Supabaseプロジェクトのanon/public key
# 3. DB_HOST: PostgreSQL接続用ホスト（通常はdb.プロジェクトID.supabase.co）
# 4. DB_PASSWORD: PostgreSQLデータベースパスワード
# 5. 環境変数は .env ファイルまたはクラウドサービス設定で管理